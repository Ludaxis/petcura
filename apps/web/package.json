{
  "name": "@petcura/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test --project=chromium --project=mobile-chrome",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:db": "playwright test --project=db",
    "test:e2e:live": "PLAYWRIGHT_SKIP_WEBSERVER=1 playwright test --project=live",
    "test:visual": "playwright test --project=visual --grep-invert @full-matrix",
    "test:a11y": "playwright test --project=accessibility",
    "check:bundle": "next build && node --experimental-strip-types scripts/check-bundle.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@petcura/ai": "*",
    "@phosphor-icons/react": "^2.1.10",
    "@petcura/shared": "*",
    "@petcura/ui": "*",
    "@petcura/validation": "*",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "inngest": "^4.4.0",
    "lucide-react": "^0.556.0",
    "motion": "^12.23.24",
    "next": "^16.2.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.7.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "twilio": "^6.0.2",
    "web-vitals": "^4.2.4",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3"
  }
}
