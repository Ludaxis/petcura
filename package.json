{
  "name": "petcura",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @petcura/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @petcura/web",
    "test:e2e:smoke": "npm run test:e2e:smoke -w @petcura/web",
    "test:e2e:db": "npm run test:e2e:db -w @petcura/web",
    "test:e2e:live": "npm run test:e2e:live -w @petcura/web",
    "test:visual": "npm run test:visual -w @petcura/web",
    "test:a11y": "npm run test:a11y -w @petcura/web",
    "test:ai": "npm run test:ai -w @petcura/ai",
    "test:rls": "supabase test db --local",
    "test:rls:linked": "supabase test db --linked",
    "db:lint": "supabase db lint --local --schema public,private --fail-on error",
    "db:lint:linked": "supabase db lint --linked --schema public,private --fail-on error"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
